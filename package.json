{
  "name": "aicut",
  "version": "0.10.0",
  "private": true,
  "description": "AI-powered video editing desktop app",
  "author": "AiCut",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperGamer4551/AiCut.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-shortcut.ps1",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run icon && npm run build && electron-builder --win",
    "updates:stage": "node scripts/stage-updates.mjs",
    "release": "npm run icon && npm run build && node scripts/ensure-release.mjs && electron-builder --win --publish always",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:timeline": "esbuild scripts/check-timeline.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-timeline.cjs --log-level=warning && node node_modules/.cache/check-timeline.cjs",
    "check:agent": "esbuild scripts/check-agent.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-agent.cjs --log-level=warning && node node_modules/.cache/check-agent.cjs",
    "check:ai": "esbuild scripts/check-ai-chat.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-ai-chat.cjs --log-level=warning && node node_modules/.cache/check-ai-chat.cjs",
    "check:export": "esbuild scripts/check-export.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/check-export.cjs --log-level=warning && node node_modules/.cache/check-export.cjs",
    "check:files": "esbuild scripts/check-files.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-files.cjs --log-level=warning && node node_modules/.cache/check-files.cjs",
    "check:youtube": "esbuild scripts/check-youtube.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-youtube.cjs --log-level=warning && node node_modules/.cache/check-youtube.cjs",
    "check:highlights": "esbuild scripts/check-highlights.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-highlights.cjs --log-level=warning && node node_modules/.cache/check-highlights.cjs",
    "check:web": "esbuild scripts/check-web.ts --bundle --platform=node --format=cjs --external:electron --outfile=node_modules/.cache/check-web.cjs --log-level=warning && node node_modules/.cache/check-web.cjs",
    "check": "npm run typecheck && npm run check:timeline && npm run check:agent && npm run check:ai && npm run check:export && npm run check:files && npm run check:youtube && npm run check:highlights && npm run check:web",
    "check:model": "esbuild scripts/check-model.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-model.cjs --log-level=warning && node node_modules/.cache/check-model.cjs",
    "check:live": "esbuild scripts/check-live.ts --bundle --platform=node --format=cjs --external:electron --external:ffmpeg-static --outfile=node_modules/.cache/check-live.cjs --log-level=warning && node node_modules/.cache/check-live.cjs",
    "check:protocol": "electron scripts/check-media-protocol.cjs"
  },
  "build": {
    "appId": "com.aicut.editor",
    "productName": "AiCut",
    "copyright": "AiCut",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "ffmpeg.exe"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "executableName": "AiCut"
    },
    "artifactName": "${productName}-Setup-${version}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "SuperGamer4551",
        "repo": "AiCut",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AiCut",
      "uninstallDisplayName": "AiCut"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^35.2.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
